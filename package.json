{
    "name": "@qboapi/qbo-mcp-server",
    "version": "0.0.1",
    "description": "MCP server implementation for QuickBooks Online integration",
    "author": "Intuit",
    "repository": {
        "type": "git",
        "url": "https://github.com/intuit/quickbooks-online-mcp-server.git"
    },
    "homepage": "https://github.com/intuit/quickbooks-online-mcp-server#readme",
    "bugs": {
        "url": "https://github.com/intuit/quickbooks-online-mcp-server/issues"
    },
    "license": "MIT",
    "main": "dist/index.js",
    "type": "module",
    "bin": "./dist/index.js",
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "npm run manifest:check && npm run build:server",
        "build:server": "tsc && shx chmod +x dist/*.js",
        "bundle": "npm run manifest:check && npm run manifest:validate && npm run build:server && npm run bundle:pack",
        "bundle:pack": "node scripts/build-bundle.mjs",
        "manifest:check": "node scripts/manifest-sync.mjs --check",
        "manifest:sync": "node scripts/manifest-sync.mjs",
        "manifest:validate": "mcpb validate manifest.json",
        "prepare": "npm run build",
        "watch": "tsc --watch",
        "lint:fix": "eslint --fix",
        "lint": "eslint .",
        "auth": "node dist/auth-server.js",
        "test": "NODE_OPTIONS='--experimental-vm-modules' jest",
        "test:watch": "NODE_OPTIONS='--experimental-vm-modules' jest --watch",
        "test:coverage": "NODE_OPTIONS='--experimental-vm-modules' jest --coverage"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.6.0",
        "dotenv": "^16.4.7",
        "intuit-oauth": "^4.0.0",
        "node-quickbooks": "^2.0.43",
        "open": "^9.1.0",
        "zod": "^3.24.2"
    },
    "devDependencies": {
        "@anthropic-ai/mcpb": "^2.1.2",
        "@eslint/js": "^9.22.0",
        "@jest/globals": "^30.3.0",
        "@types/jest": "^30.0.0",
        "@types/node": "^22.13.10",
        "eslint": "^9.22.0",
        "eslint-config-prettier": "^10.1.1",
        "globals": "^16.0.0",
        "jest": "^30.2.0",
        "prettier": "3.5.3",
        "shx": "^0.3.4",
        "ts-jest": "^29.4.6",
        "typescript": "^5.8.2",
        "typescript-eslint": "^8.26.1"
    }
}
